#--------------------------------------------------------------------
# Environment Configuration Example
#--------------------------------------------------------------------
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT=development

#--------------------------------------------------------------------
# API Keys
#--------------------------------------------------------------------

GITHUB_TOKEN=your_github_token_here
OPENAI_API_KEY=your_openai_api_key_here
AI_INTERVIEW_OPENAI_API_KEY=your_ai_interview_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

#--------------------------------------------------------------------
# PAYMENT (RAZORPAY)
#--------------------------------------------------------------------

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

#--------------------------------------------------------------------
# ADMIN ANALYTICS LOGIN
#--------------------------------------------------------------------

admin.analyticsEmail=admin@local.test
admin.analyticsPassword=admin123
# Prefer this in shared environments instead of admin.analyticsPassword.
# Generate with: php -r "echo password_hash('admin123', PASSWORD_DEFAULT), PHP_EOL;"
admin.analyticsPasswordHash=

#--------------------------------------------------------------------
# CRON
#--------------------------------------------------------------------

cron.secret=change_this_to_a_secure_random_secret

#--------------------------------------------------------------------
# EMAIL (SMTP) - Gmail temporary testing
#--------------------------------------------------------------------

# Temporary testing only. Use Gmail app password, not your normal Gmail password.
email.fromEmail=yourgmail@gmail.com
email.fromName=HireMatrix Test
email.protocol=smtp
email.SMTPHost=smtp.gmail.com
email.SMTPUser=yourgmail@gmail.com
email.SMTPPass=your_gmail_app_password
email.SMTPPort=587
email.SMTPCrypto=tls
email.mailType=html
email.captureLinks=true

# Optional Gmail aliases used by app/Config/Email.php
GMAIL_FROM_EMAIL=yourgmail@gmail.com
GMAIL_FROM_NAME=HireMatrix Test
GMAIL_PROTOCOL=smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_USER=yourgmail@gmail.com
GMAIL_SMTP_PASS=your_gmail_app_password
GMAIL_SMTP_PORT=587
GMAIL_SMTP_CRYPTO=tls
GMAIL_MAIL_TYPE=html

#--------------------------------------------------------------------
# FAST2SMS (RECRUITER PHONE OTP)
#--------------------------------------------------------------------

fast2sms.apiKey=your_fast2sms_api_key
fast2sms.endpoint=https://www.fast2sms.com/dev/bulkV2

#--------------------------------------------------------------------
# GOOGLE OAUTH
#--------------------------------------------------------------------

google.clientId=your_google_client_id
google.clientSecret=your_google_client_secret
google.redirectUri=http://localhost:8080/auth/google-calendar/callback

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Update baseURL to match your setup:
# - XAMPP: http://localhost/your-project-name/public/
# - Virtual Host: http://yourdomain.local/
# - Production: https://yourdomain.com/

app.baseURL=http://localhost/your-project-name/public/
app.forceGlobalSecureRequests=false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname=localhost
database.default.database=ai_job_portal1
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate new key: php spark key:generate

encryption.key=
encryption.driver=OpenSSL
encryption.blockSize=16
encryption.digest=SHA512

#--------------------------------------------------------------------
# RESUME PDF PREVIEW / EXPORT
#--------------------------------------------------------------------
# Optional. Set this if Chrome/Chromium is not available in PATH.

resume.chromePath=

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

security.csrfProtection=cookie
security.tokenRandomize=false
security.tokenName=csrf_token_name
security.headerName=X-CSRF-TOKEN
security.cookieName=csrf_cookie_name
security.expires=7200
security.regenerate=true
security.redirect=false
security.samesite=Lax

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver=CodeIgniter\Session\Handlers\FileHandler
session.cookieName=ci_session
session.expiration=7200
session.matchIP=false
session.timeToUpdate=300
session.regenerateDestroy=false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold=4
